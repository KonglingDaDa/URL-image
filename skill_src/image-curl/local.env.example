# 生图专用配置（仅本 skill 使用）
# 安装后执行：cp local.env.example local.env
# 然后把在 aicode.cat 控制台「API 密钥」页为生图分组新建的 Key 填到下面。
# 本文件里的值优先于同名环境变量。

# GPT 生图分组的 Key（gpt-image-2 等）
IMAGE_CURL_API_KEY=在此填入GPT生图分组的Key

# Gemini 生图分组的 Key（gemini-nano-banana-2.1、gemini-3.1-flash-image）
# IMAGE_CURL_GEMINI_API_KEY=在此填入Gemini生图分组的Key

# 不传 --model 时的默认模型；只有 Gemini Key 时改成 gemini-nano-banana-2.1
# IMAGE_CURL_MODEL=gpt-image-2

# IMAGE_CURL_BASE_URL=https://aicode.cat
# IMAGE_CURL_OUTPUT_DIR=./.image-curl-output
# 无图返回、5xx、网络抖动、url 下载失败时的总尝试次数（默认 3）
# IMAGE_CURL_SAVE_RETRIES=3
